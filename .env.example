# Google Apps Script web app deployment URL (shared)
VITE_CONTACT_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Local dev: .env.development uses Cloudflare TEST site key (1x0000...AA)
# Production: set VITE_TURNSTILE_SITE_KEY in GitHub Actions secrets
# After any .env change: stop dev server and run npm run dev again